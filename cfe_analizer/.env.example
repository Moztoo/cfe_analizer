# Configuración de Datos Personales del Suministro CFE (Ejemplo sin datos reales)
# Copia este archivo a .env y reemplaza con tus datos.

CFE_TITULAR="NOMBRE DEL TITULAR"
CFE_RPU="000000000000"
CFE_RFC="XAXX010101000"
CFE_RMU="00000000000XXXX0000000000"
CFE_MEDIDOR="XXXXXX"
CFE_DIRECCION="CALLE Y NUMERO 000"
CFE_COLONIA="COLONIA"
CFE_CP="00000"
CFE_MUNICIPIO="CIUDAD, ESTADO"
